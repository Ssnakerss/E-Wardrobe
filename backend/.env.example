# Database connection string
DATABASE_URL=postgres://wardrobe:wardrobe_dev@localhost:5432/wardrobe?sslmode=disable

# HTTP server
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# Photo storage
PHOTO_STORAGE_DIR=./photos

# Session
SESSION_COOKIE_SECURE=false
SESSION_TTL=24h

# Invitation
INVITATION_DEFAULT_TTL=168h

# Upload
MAX_UPLOAD_BYTES=12582912

# Logging
LOG_LEVEL=info
